{
  "components": [
    {
      "name": "board",
      "namespace": "rdk",
      "type": "board",
      "model": "fieldwork:fake-modules-go:fake-board",
      "attributes": {
        "analogs": [],
        "digital_interrupts": []
      }
    },
    {
      "name": "belt-motor",
      "namespace": "rdk",
      "type": "motor",
      "model": "fieldwork:fake-modules-go:fake-motor",
      "attributes": {
        "enable_position": true,
        "max_speed_rpm": 200
      },
      "depends_on": [
        "board"
      ]
    },
    {
      "name": "entry-sensor",
      "namespace": "rdk",
      "type": "sensor",
      "model": "fieldwork:fake-modules-go:fake-sensor",
      "attributes": {
        "timeout_ms": 50,
        "board": "board",
        "trigger_pin": "11",
        "echo_pin": "13"
      },
      "depends_on": [
        "board"
      ]
    },
    {
      "name": "exit-sensor",
      "namespace": "rdk",
      "type": "sensor",
      "model": "fieldwork:fake-modules-go:fake-sensor",
      "attributes": {
        "timeout_ms": 50,
        "board": "board",
        "trigger_pin": "15",
        "echo_pin": "16"
      },
      "depends_on": [
        "board"
      ]
    },
    {
      "name": "event-manager",
      "namespace": "rdk",
      "type": "sensor",
      "model": "viam:event-manager:eventing",
      "attributes": {
        "check_interval_ms": 500,
        "rules": [
          {
            "condition": "entry-sensor.distance < 0.05 && exit-sensor.distance > 0.5",
            "severity": "error",
            "name": "jam_detected"
          },
          {
            "name": "throughput_low",
            "condition": "entry-sensor.count < 10",
            "severity": "warning"
          }
        ],
        "sensors": [
          "entry-sensor",
          "exit-sensor"
        ]
      },
      "depends_on": [
        "entry-sensor",
        "exit-sensor"
      ]
    }
  ],
  "modules": [
    {
      "type": "registry",
      "name": "viam_event-manager",
      "module_id": "viam:event-manager",
      "version": "latest"
    },
    {
      "type": "registry",
      "name": "fieldwork_fake-modules-go",
      "module_id": "fieldwork:fake-modules-go",
      "version": "latest"
    }
  ],
  "description": "Fixed conveyor controller config. Includes belt motor, entry/exit ultrasonic sensors, and event manager for jam and throughput alerting. Used by all aus-/chi-/sea-conveyor-ctrl-* machines."
}
