{
  "description": "Fixed conveyor controller config. Includes belt motor, entry/exit ultrasonic sensors, and event manager for jam and throughput alerting. Used by all aus-/chi-/sea-conveyor-ctrl-* machines.",
  "modules": [
    {
      "type": "registry",
      "name": "rand_fake-modules-go",
      "module_id": "rand:fake-modules-go",
      "version": "latest"
    },
    {
      "type": "registry",
      "name": "viam_event-manager",
      "module_id": "viam:event-manager",
      "version": "latest"
    }
  ],
  "components": [
    {
      "name": "board",
      "model": "rand:fake-modules-go:fake-board",
      "type": "board",
      "namespace": "rdk",
      "attributes": {
        "analogue_readers": [],
        "digital_interrupts": []
      },
      "depends_on": []
    },
    {
      "name": "belt-motor",
      "model": "rand:fake-modules-go:fake-motor",
      "type": "motor",
      "namespace": "rdk",
      "attributes": {
        "board": "board",
        "dir_flip": false,
        "max_rpm": 200,
        "ticks_per_rotation": 1600
      },
      "depends_on": ["board"]
    },
    {
      "name": "entry-sensor",
      "model": "rand:fake-modules-go:fake-sensor",
      "type": "sensor",
      "namespace": "rdk",
      "attributes": {
        "board": "board",
        "trigger_pin": "11",
        "echo_pin": "13",
        "timeout_ms": 50
      },
      "depends_on": ["board"]
    },
    {
      "name": "exit-sensor",
      "model": "rand:fake-modules-go:fake-sensor",
      "type": "sensor",
      "namespace": "rdk",
      "attributes": {
        "board": "board",
        "trigger_pin": "15",
        "echo_pin": "16",
        "timeout_ms": 50
      },
      "depends_on": ["board"]
    },
    {
      "name": "event-manager",
      "model": "viam:event-manager:eventing",
      "type": "sensor",
      "namespace": "rdk",
      "attributes": {
        "sensors": ["entry-sensor", "exit-sensor"],
        "check_interval_ms": 500,
        "rules": [
          {
            "name": "jam_detected",
            "condition": "entry-sensor.distance < 0.05 && exit-sensor.distance > 0.5",
            "severity": "error"
          },
          {
            "name": "throughput_low",
            "condition": "entry-sensor.count < 10",
            "severity": "warning"
          }
        ]
      },
      "depends_on": ["entry-sensor", "exit-sensor"]
    }
  ]
}
