{
  "components": [
    {
      "name": "board",
      "namespace": "rdk",
      "type": "board",
      "model": "fieldwork:fake-modules-go:fake-board",
      "attributes": {
        "digital_interrupts": [],
        "analogs": []
      }
    },
    {
      "name": "arm",
      "namespace": "rdk",
      "type": "arm",
      "model": "fieldwork:fake-modules-go:fake-arm",
      "attributes": {
        "speed_degs_per_sec": 30,
        "acceleration_degs_per_sec_per_sec": 15,
        "host": "192.168.1.10",
        "port": 18333
      }
    },
    {
      "name": "gripper",
      "namespace": "rdk",
      "type": "gripper",
      "model": "fieldwork:fake-modules-go:fake-gripper",
      "attributes": {
        "open_timeout_ms": 2000,
        "board": "board",
        "open_pin": "7",
        "close_pin": "8",
        "grip_force_n": 40
      },
      "depends_on": [
        "board"
      ]
    },
    {
      "name": "wrist-cam",
      "namespace": "rdk",
      "type": "camera",
      "model": "fieldwork:fake-modules-go:fake-camera",
      "attributes": {
        "width_px": 848,
        "height_px": 480,
        "frame_rate": 60,
        "depth_enabled": true
      }
    },
    {
      "name": "force-sensor",
      "namespace": "rdk",
      "type": "sensor",
      "model": "fieldwork:fake-modules-go:fake-sensor",
      "attributes": {
        "board": "board",
        "i2c_bus": "1",
        "max_force_n": 100,
        "overload_threshold_n": 85
      },
      "depends_on": [
        "board"
      ]
    }
  ],
  "services": [
    {
      "name": "detector",
      "api": "rdk:service:vision",
      "model": "rdk:builtin:fake",
      "attributes": {
        "model_location": "yolov8n.pt",
        "task": "detect"
      }
    }
  ],
  "modules": [
    {
      "type": "registry",
      "name": "fieldwork_fake-modules-go",
      "module_id": "fieldwork:fake-modules-go",
      "version": "latest"
    }
  ],
  "description": "Pick-and-place arm config. Includes xArm6, gripper, wrist-mounted depth camera, force sensor, and fake vision detector. Used by all aus-/chi-/sea-pick-arm-* machines."
}
