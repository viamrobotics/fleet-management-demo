{
  "components": [
    {
      "name": "board",
      "namespace": "rdk",
      "type": "board",
      "model": "fieldwork:fake-modules-go:fake-board",
      "attributes": {
        "digital_interrupts": [],
        "analogs": []
      }
    },
    {
      "name": "front-cam",
      "namespace": "rdk",
      "type": "camera",
      "model": "fieldwork:fake-modules-go:fake-camera",
      "attributes": {
        "frame_rate": 30,
        "width_px": 1280,
        "height_px": 720
      }
    },
    {
      "name": "lidar",
      "namespace": "rdk",
      "type": "camera",
      "model": "fieldwork:fake-modules-go:fake-camera",
      "attributes": {
        "baud_rate": 115200,
        "timeout_ms": 1000,
        "serial_path": "/dev/ttyUSB0"
      }
    },
    {
      "name": "imu",
      "namespace": "rdk",
      "type": "movement_sensor",
      "model": "fieldwork:fake-modules-go:fake-movementsensor",
      "attributes": {},
      "depends_on": [
        "board"
      ]
    },
    {
      "name": "drive-base",
      "namespace": "rdk",
      "type": "base",
      "model": "fieldwork:fake-modules-go:fake-base",
      "attributes": {
        "wheel_circumference_mm": 381,
        "width_mm": 580
      }
    }
  ],
  "services": [
    {
      "name": "detector",
      "api": "rdk:service:vision",
      "model": "rdk:builtin:fake",
      "attributes": {
        "model_location": "yolov8n.pt",
        "task": "detect"
      },
      "depends_on": [
        "front-cam",
        "lidar"
      ]
    }
  ],
  "modules": [
    {
      "type": "registry",
      "name": "fieldwork_fake-modules-go",
      "module_id": "fieldwork:fake-modules-go",
      "version": "latest"
    }
  ],
  "description": "Mobile inspection bot config. Includes drive base, front camera, lidar, IMU, and YOLOv8 object detector. Used by all aus-/chi-/sea-inspection-bot-* machines."
}
